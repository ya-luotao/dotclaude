#!/usr/bin/env bash
# dotclaude — manage multiple Claude Code accounts (profiles) on one machine.
# https://github.com/ya-luotao/dotclaude
set -euo pipefail

VERSION="0.9.0"
DOTCLAUDE_HOME="${DOTCLAUDE_HOME:-$HOME/.dotclaude}"
PROFILES_DIR="$DOTCLAUDE_HOME/profiles"

# Items that may be shared (symlinked) between profiles. Credentials and
# history are deliberately excluded and can never be added via arguments.
# `plugins` is in the default set: marketplaces and installed plugins are
# machine-level, not account-level, and the store is large (hundreds of MB)
# — one copy per profile is pure waste.
# `projects` (session transcripts) is shareable but strictly opt-in: never
# part of the default set, because it merges session history across accounts.
SHARE_WHITELIST="agents skills commands plugins hooks settings.json keybindings.json CLAUDE.md projects"
SHARE_DEFAULT="agents skills commands plugins hooks settings.json keybindings.json CLAUDE.md"
NEVER_SHARE=".credentials.json .claude.json history.jsonl todos sessions cache"

err()  { printf 'dotclaude: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }
bold() { printf '\033[1m%s\033[0m' "$1"; }

# Single source of truth for the command list: name^args^summary.
# `usage` renders it; `help <cmd>` validates against it; tests assert every
# row here has a working `help` topic and a dispatch entry.
commands_table() {
  cat <<'EOF'
setup^<name>^Create a profile and log in to it
run^<name> [args...]^Launch claude with a profile ("default" = plain claude)
use^[name|default]^Route bare claude globally to a profile (no arg: show; default: clear)
list^^List profiles with account and login status
current^^Show which profile is active here and why
bind^<name> [dir]^Bind a project directory to a profile (.dotclaude file)
unbind^[dir]^Remove a project binding
share^<name> [items...]^Symlink shared config from ~/.claude into a profile
unshare^<name> [items...]^Remove shared symlinks (restores .bak if present)
items^[name] [--names]^List each profile's agents, skills, commands and plugins
doctor^^Check for common multi-account pitfalls
usage^[name]^Show cached 5h/weekly rate-limit usage per profile
du^^Disk usage per profile
clean^<name> [--days N] [--force]^Delete old session transcripts (dry-run unless --force)
keep^<name> [--days N]^Retain sessions ~forever (sets cleanupPeriodDays, default 999999)
shellenv^[--alias NAME]^Print shell integration (claude() wrapper + optional alias)
help^[command]^Show this help, or detailed help for one command
version^^Print version
EOF
}

usage() {
  echo "dotclaude $VERSION — manage multiple Claude Code accounts (profiles) on one machine"
  echo
  echo "Usage: dotclaude <command> [args...]"
  echo
  echo "Commands:"
  commands_table | while IFS='^' read -r name args summary; do
    printf '  %-9s %-27s %s\n' "$name" "$args" "$summary"
  done
  cat <<'EOF'

Run 'dotclaude help <command>' (or 'dotclaude <command> --help') for details.

Profiles:
  "default" is your existing login (no CLAUDE_CONFIG_DIR; uses ~/.claude).
  Named profiles live in ~/.dotclaude/profiles/<name> via CLAUDE_CONFIG_DIR.

Add to ~/.zshrc for per-project binding, global routing, and a short alias:
  eval "$(dotclaude shellenv --alias dc)"
EOF
}

help_detail() {
  case "$1" in
    setup) cat <<'EOF'
Creates ~/.dotclaude/profiles/<name> and launches claude with
CLAUDE_CONFIG_DIR pointing at it — run /login inside, then /status to confirm.
Refuses existing profiles, invalid names, and "default" (your real ~/.claude
login never needs setup).

  dotclaude setup team
EOF
;;
    run) cat <<'EOF'
Launches claude as the given profile; every extra argument passes through.
"run default" launches with CLAUDE_CONFIG_DIR explicitly unset — the default
login must never see the variable (it moves .claude.json lookup).

  dotclaude run team
  dotclaude run team -p "summarize this repo"
  dotclaude run default --resume
EOF
;;
    use) cat <<'EOF'
Sets the global route: bare `claude` (via the shellenv wrapper) uses this
profile everywhere. Resolution order stays:
explicit CLAUDE_CONFIG_DIR > project .dotclaude binding > global route > default.

  dotclaude use team       # route bare claude to "team"
  dotclaude use            # show the current route
  dotclaude use default    # clear the route
EOF
;;
    list) cat <<'EOF'
Lists every profile with the logged-in account (email + organization, read
from the profile's .claude.json) and its directory. "*" marks the profile
active in the current directory/environment.
EOF
;;
    current) cat <<'EOF'
Prints the profile that bare `claude` would use right here, and why:
explicit CLAUDE_CONFIG_DIR, a project .dotclaude binding, the global route,
or the default login.
EOF
;;
    bind) cat <<'EOF'
Writes the profile name to <dir>/.dotclaude (default: current directory).
The shellenv claude() wrapper walks up from $PWD and uses the nearest
binding. Add .dotclaude to .gitignore — bindings are machine-local.

  cd ~/work/company-repo && dotclaude bind team
EOF
;;
    unbind) cat <<'EOF'
Removes <dir>/.dotclaude (default: current directory). Bindings in parent
directories are never touched.
EOF
;;
    share) cat <<'EOF'
Symlinks items from ~/.claude into the profile so both accounts see the same
config. Shareable items (hardcoded whitelist): agents skills commands
plugins hooks settings.json keybindings.json CLAUDE.md projects. Credentials,
history, and .claude.json can never be shared — that would break account
isolation. An existing real file or directory is preserved as <item>.bak.

`settings.json` (model, theme, permissions, hooks config, enabledPlugins,
cleanupPeriodDays) is shared by default, so every sharing profile runs on
one settings file: change a setting in one and all of them follow. Only
settings.local.json stays per-profile. A profile that had its own
settings.json keeps it at settings.json.bak; unshare puts it back.

`plugins` shares the whole plugin store — marketplaces, installed plugins,
and their cache (typically hundreds of MB, so one copy instead of one per
profile). It is shared by default: what you install is machine-level, not
account-level. Installing or removing a plugin, or adding a marketplace,
then does it for every sharing profile. Which plugins are *enabled* lives
in settings.json, so it is shared exactly when settings.json is; `dotclaude
items` shows both. A profile that already has its own plugins keeps them at
plugins.bak; they are not merged into the shared store.

`projects` (session transcripts) is opt-in only — never included when items
are omitted, because it merges session history across accounts. Sharing it
first copies the profile's existing transcripts into ~/.claude/projects
(the original is kept as projects.bak), then symlinks, so every sharing
profile sees and resumes the same sessions — project memory included. Set a
retention horizon on EVERY participating profile (dotclaude keep <name>),
or one profile's 30-day default cleanup will prune the shared store.

  dotclaude share team                  # link every config item
  dotclaude share team agents CLAUDE.md
  dotclaude share team agents skills commands plugins hooks CLAUDE.md
                                        # everything except settings.json
  dotclaude share team projects         # opt in to shared sessions
EOF
;;
    unshare) cat <<'EOF'
Removes shared symlinks (only symlinks — a real file is never deleted) and
restores <item>.bak if one exists. Like share, `projects` must be named
explicitly; unsharing it restores the pre-share transcripts, while
transcripts created during sharing remain in ~/.claude/projects.
EOF
;;
    items) cat <<'EOF'
Lists, per profile, what config it actually has: how many agents, skills,
commands and hook scripts it can load, how many plugins are installed and
how many of those are enabled, and whether it has a settings.json,
keybindings.json and global CLAUDE.md — with a state column saying whether
each item is the profile's own copy or shared (symlinked) from ~/.claude. A
symlink pointing anywhere else is shown as its target, and a shared item
whose source is gone is flagged BROKEN LINK (also see: doctor).

Plugin enable/disable lives in settings.json, so it is shared only when
settings.json is: two profiles on one shared plugin store with their own
settings can differ in what is enabled — the "N installed, M on" counts
show that.

  dotclaude items               # every profile, counts only
  dotclaude items team          # one profile
  dotclaude items team --names  # spell out the skill and plugin names
EOF
;;
    doctor) cat <<'EOF'
Checks for the pitfalls that break multi-account setups: ANTHROPIC_API_KEY
set (overrides /login for every profile), shell wrapper not installed,
a global route pointing at a missing profile, dangling share symlinks,
per-profile login status, and — when sessions are shared — profiles whose
default 30-day cleanup would prune the shared store.
EOF
;;
    usage) cat <<'EOF'
Shows the 5-hour session window, weekly window, and per-model weekly limits
(utilization % + reset time) for each profile, plus how old the data is.

Reads Claude Code's own local cache (cachedUsageUtilization in the profile's
.claude.json) — no network requests, no credentials touched. The cache
refreshes while claude runs; there is no official CLI or API for these
numbers, so this relies on an undocumented format and may break with Claude
Code updates. The /usage command inside claude is the authoritative view.

  dotclaude usage               # all profiles
  dotclaude usage team          # one profile
EOF
;;
    du) cat <<'EOF'
Shows disk usage per profile, with the sessions (projects/) share broken out —
session transcripts are usually where the gigabytes are (see: dotclaude clean).
EOF
;;
    clean) cat <<'EOF'
Deletes session transcripts (*.jsonl under <profile>/projects) older than
--days (default 30). DRY-RUN unless --force is given: without it, nothing is
deleted and the output shows what would be.

A profile with shared sessions (projects symlinked, see: dotclaude help
share) is refused — cleaning through the link would touch every profile's
transcripts. Prune the shared store deliberately via `clean default`.

  dotclaude clean team --days 60           # preview
  dotclaude clean team --days 60 --force   # actually delete
  dotclaude clean default --days 60        # the shared store (~/.claude)
EOF
;;
    keep) cat <<'EOF'
Stops Claude Code from auto-deleting this profile's session transcripts by
setting cleanupPeriodDays in the profile's settings.json (default here:
999999 days ≈ forever; Claude Code's own default is 30). Other settings in
the file are preserved. When the profile's settings.json is shared (see:
dotclaude help share) the value is written through the link, so it applies
to every profile sharing that file — the link itself is left intact.
--days 0 is refused: a known Claude Code bug makes 0 disable transcript
writing entirely instead of disabling cleanup. Note: retained sessions add
up — see `dotclaude du`, and use `dotclaude clean` when you want to prune
manually.

  dotclaude keep default          # keep your main login's sessions forever
  dotclaude keep team --days 365  # or pick a horizon
EOF
;;
    shellenv) cat <<'EOF'
Prints shell code: a claude() wrapper implementing project bindings and the
global route, plus an optional short alias. Add to ~/.zshrc:

  eval "$(dotclaude shellenv --alias dc)"

Only shells that sourced it are affected — scripts and other tools calling
the claude binary directly should use `dotclaude run <name>` instead.
EOF
;;
    help) cat <<'EOF'
With no argument, shows the command overview. With a command name, shows
detailed help for it. `dotclaude <command> --help` is equivalent.
EOF
;;
    version) cat <<'EOF'
Prints the dotclaude version.
EOF
;;
  esac
}

cmd_help() {
  local topic="${1:-}"
  if [ -z "$topic" ]; then usage; return; fi
  local line
  line="$(commands_table | grep "^${topic}\^" || true)"
  [ -n "$line" ] || die "unknown command: $topic (see: dotclaude help)"
  printf 'Usage: dotclaude %s %s\n' "$topic" "$(printf '%s' "$line" | cut -d'^' -f2)"
  printf '  %s\n\n' "$(printf '%s' "$line" | cut -d'^' -f3)"
  help_detail "$topic"
}

# ---------- helpers ----------

valid_name() {
  case "$1" in
    ''|*[!a-zA-Z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

profile_dir() {
  if [ "$1" = "default" ]; then printf '%s' "$HOME/.claude"; else printf '%s' "$PROFILES_DIR/$1"; fi
}

config_json() {
  if [ "$1" = "default" ]; then printf '%s' "$HOME/.claude.json"; else printf '%s' "$PROFILES_DIR/$1/.claude.json"; fi
}

profile_exists() {
  [ "$1" = "default" ] && { [ -d "$HOME/.claude" ] || [ -f "$HOME/.claude.json" ]; } && return 0
  [ -d "$PROFILES_DIR/$1" ]
}

all_profiles() {
  # default first if present, then named profiles sorted
  if [ -d "$HOME/.claude" ] || [ -f "$HOME/.claude.json" ]; then echo default; fi
  if [ -d "$PROFILES_DIR" ]; then
    ls -1 "$PROFILES_DIR" 2>/dev/null | sort
  fi
}

# json_get FILE JQ_PATH  (jq path like .oauthAccount.emailAddress)
json_get() {
  local file="$1" path="$2"
  [ -f "$file" ] || return 1
  if command -v jq >/dev/null 2>&1; then
    jq -r "$path // empty" "$file" 2>/dev/null
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$file" "$path" <<'PY' 2>/dev/null
import json, sys
data = json.load(open(sys.argv[1]))
for key in sys.argv[2].lstrip('.').split('.'):
    if not isinstance(data, dict) or key not in data:
        sys.exit(0)
    data = data[key]
if isinstance(data, (str, int, float)):
    print(data)
PY
  fi
}

account_summary() {
  # prints "email (org)" or "not logged in"
  local cfg="$1" email org
  email="$(json_get "$cfg" '.oauthAccount.emailAddress' || true)"
  org="$(json_get "$cfg" '.oauthAccount.organizationName' || true)"
  if [ -n "$email" ]; then
    if [ -n "$org" ]; then printf '%s (%s)' "$email" "$org"; else printf '%s' "$email"; fi
  else
    printf 'not logged in'
  fi
}

find_binding() {
  # walk up from $1 looking for .dotclaude; prints "profile<TAB>dir" if found
  local d="$1"
  while :; do
    if [ -f "$d/.dotclaude" ]; then
      printf '%s\t%s\n' "$(head -n1 "$d/.dotclaude" | tr -d '[:space:]')" "$d"
      return 0
    fi
    [ "$d" = "/" ] && return 1
    d="$(dirname "$d")"
  done
}

require_profile() {
  profile_exists "$1" || die "profile '$1' does not exist (see: dotclaude list)"
}

# ---------- commands ----------

cmd_setup() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: dotclaude setup <name>"
  valid_name "$name" || die "invalid profile name '$name' (use letters, digits, - and _)"
  [ "$name" = "default" ] && die "'default' is your existing ~/.claude login; it never needs setup"
  local dir="$PROFILES_DIR/$name"
  [ -e "$dir" ] && die "profile '$name' already exists at $dir"
  mkdir -p "$dir"
  echo "Created profile '$name' at $dir"
  echo "Launching claude to log in — run /login inside, then /status to confirm the account."
  exec env CLAUDE_CONFIG_DIR="$dir" claude
}

cmd_run() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: dotclaude run <name> [args...]"
  shift
  require_profile "$name"
  if [ "$name" = "default" ]; then
    exec env -u CLAUDE_CONFIG_DIR claude "$@"
  fi
  exec env CLAUDE_CONFIG_DIR="$(profile_dir "$name")" claude "$@"
}

global_route() {
  # prints the globally routed profile name, if any
  [ -f "$DOTCLAUDE_HOME/current" ] && head -n1 "$DOTCLAUDE_HOME/current" | tr -d '[:space:]'
}

cmd_use() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    local cur
    cur="$(global_route || true)"
    if [ -n "$cur" ]; then echo "$cur"; else echo "no global route (bare 'claude' uses the default login)"; fi
    return
  fi
  if [ "$name" = "default" ]; then
    rm -f "$DOTCLAUDE_HOME/current"
    echo "Global route cleared — bare 'claude' uses the default login."
    return
  fi
  require_profile "$name"
  mkdir -p "$DOTCLAUDE_HOME"
  printf '%s\n' "$name" > "$DOTCLAUDE_HOME/current"
  echo "Global route set: bare 'claude' now uses profile '$name'."
  echo "(project .dotclaude bindings and an explicit CLAUDE_CONFIG_DIR still win)"
  if [ "${DOTCLAUDE_WRAPPER:-}" != "1" ]; then
    echo "Hint: routing takes effect via the claude() wrapper — add to ~/.zshrc:"
    echo '  eval "$(dotclaude shellenv --alias dc)"'
  fi
}

cmd_list() {
  local name cfg dir marker active=""
  active="$(cmd_current_name)"
  printf '%-14s %-42s %s\n' "PROFILE" "ACCOUNT" "DIR"
  for name in $(all_profiles); do
    dir="$(profile_dir "$name")"
    cfg="$(config_json "$name")"
    marker=" "
    [ "$name" = "$active" ] && marker="*"
    printf '%s %-12s %-42s %s\n' "$marker" "$name" "$(account_summary "$cfg")" "$dir"
  done
  [ -n "$active" ] && echo && echo "* = active in this directory/environment"
}

cmd_current_name() {
  # precedence: explicit env > project binding > default
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    local n
    n="$(basename "$CLAUDE_CONFIG_DIR")"
    if [ "$(dirname "$CLAUDE_CONFIG_DIR")" = "$PROFILES_DIR" ]; then printf '%s' "$n"; else printf '%s' "$CLAUDE_CONFIG_DIR"; fi
    return
  fi
  local hit cur
  if hit="$(find_binding "$PWD")"; then
    printf '%s' "$(printf '%s' "$hit" | cut -f1)"
    return
  fi
  cur="$(global_route || true)"
  if [ -n "$cur" ]; then printf '%s' "$cur"; return; fi
  printf 'default'
}

cmd_current() {
  local name src=""
  name="$(cmd_current_name)"
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    src="CLAUDE_CONFIG_DIR is set"
  else
    local hit
    if hit="$(find_binding "$PWD")"; then
      src="bound via $(printf '%s' "$hit" | cut -f2)/.dotclaude"
    elif [ -n "$(global_route || true)" ]; then
      src="global route via $DOTCLAUDE_HOME/current"
    else
      src="no binding; default login"
    fi
  fi
  echo "$name  ($src)"
}

cmd_bind() {
  local name="${1:-}" dir="${2:-$PWD}"
  [ -n "$name" ] || die "usage: dotclaude bind <name> [dir]"
  require_profile "$name"
  [ -d "$dir" ] || die "no such directory: $dir"
  printf '%s\n' "$name" > "$dir/.dotclaude"
  echo "Bound $dir -> profile '$name'"
  if [ -d "$dir/.git" ] && ! grep -qs '^\.dotclaude$' "$dir/.gitignore" 2>/dev/null; then
    echo "Hint: add .dotclaude to $dir/.gitignore (binding is machine-local)."
  fi
  if [ "${DOTCLAUDE_WRAPPER:-}" != "1" ]; then
    echo "Hint: binding takes effect via the claude() wrapper — add to ~/.zshrc:"
    echo '  eval "$(dotclaude shellenv --alias dc)"'
  fi
}

cmd_unbind() {
  local dir="${1:-$PWD}"
  if [ -f "$dir/.dotclaude" ]; then
    rm "$dir/.dotclaude"
    echo "Removed binding in $dir"
  else
    err "no .dotclaude file in $dir (bindings in parent dirs are left alone)"
  fi
}

in_whitelist() {
  local item w
  for w in $SHARE_WHITELIST; do [ "$1" = "$w" ] && return 0; done
  return 1
}

# merge_tree SRC DEST — copy every file under SRC that DEST doesn't have yet,
# preserving relative paths. Files already in DEST are never overwritten.
merge_tree() {
  local from="$1" into="$2"
  (cd "$from" && find . -type f -print0) | while IFS= read -r -d '' rel; do
    rel="${rel#./}"
    if [ ! -e "$into/$rel" ]; then
      # explicit exit: errexit is suspended inside functions called via ||
      { mkdir -p "$into/$(dirname "$rel")" && cp -p "$from/$rel" "$into/$rel"; } || exit 1
    fi
  done
}

have_json_tool() { command -v jq >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; }

# Warn when a sessions-sharing profile still has Claude Code's 30-day default
# cleanup: its auto-cleanup would prune the SHARED store for every account.
# Without a JSON tool the setting is unreadable — skip rather than cry wolf.
sessions_cleanup_note() {
  local name="$1" dir="$2" days
  have_json_tool || return 0
  days="$(json_get "$dir/settings.json" .cleanupPeriodDays || true)"
  if [ -z "$days" ]; then
    echo "note cleanupPeriodDays is unset for '$name' — its 30-day default cleanup"
    echo "     now prunes the SHARED session store. Consider: dotclaude keep $name"
  fi
}

# Opt-in sessions sharing: merge the profile's transcripts into the shared
# store first so nothing drops out of --resume, keep the original as
# projects.bak, then symlink. Merge completes before anything moves aside —
# a failure leaves the profile untouched. See SPEC S7.
share_projects() {
  local name="$1" dir="$2" src="$3" dst="$4"
  mkdir -p "$src"
  if [ -L "$dst" ]; then
    if [ "$(readlink "$dst")" = "$src" ]; then
      echo "ok   projects (already shared)"
      sessions_cleanup_note "$name" "$dir"
      return 0
    fi
    # a foreign symlink would be discarded without merge or backup — refuse
    die "projects in profile '$name' is already a symlink to $(readlink "$dst") — not touching it; migrate or remove it manually, then re-run"
  fi
  if [ -e "$dst" ] && [ -e "$dst.bak" ]; then
    die "$dst.bak already exists (interrupted earlier share?) — mv would nest into it; resolve the stale backup first"
  fi
  if [ -d "$dst" ]; then
    merge_tree "$dst" "$src" || die "merging $dst into $src failed — nothing was moved"
    mv "$dst" "$dst.bak"
    echo "note projects: transcripts merged into $src; original kept at $dst.bak"
  elif [ -e "$dst" ]; then
    mv "$dst" "$dst.bak"
    echo "note projects: existing file moved to $dst.bak"
  fi
  ln -s "$src" "$dst"
  echo "link projects -> $src (sessions now shared with the default profile)"
  sessions_cleanup_note "$name" "$dir"
}

cmd_share() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: dotclaude share <name> [items...]"
  [ "$name" = "default" ] && die "default is the share source; pick a named profile"
  require_profile "$name"
  shift
  local items="${*:-$SHARE_DEFAULT}" item src dst
  local dir="$PROFILES_DIR/$name"
  for item in $items; do
    in_whitelist "$item" || die "'$item' is not shareable (allowed: $SHARE_WHITELIST)"
    src="$HOME/.claude/$item"
    dst="$dir/$item"
    if [ "$item" = "projects" ]; then
      share_projects "$name" "$dir" "$src" "$dst"
      continue
    fi
    if [ ! -e "$src" ]; then
      err "skip $item: $src does not exist"
      continue
    fi
    if [ -L "$dst" ]; then
      [ "$(readlink "$dst")" = "$src" ] && { echo "ok   $item (already shared)"; continue; }
      rm "$dst"
    elif [ -e "$dst" ]; then
      # same hazard as projects: mv would nest a directory into its own stale
      # backup, and would silently discard an older file backup
      [ -e "$dst.bak" ] && die "$dst.bak already exists (interrupted earlier share?) — resolve the stale backup first"
      mv "$dst" "$dst.bak"
      echo "note $item: existing $( [ -d "$dst.bak" ] && echo directory || echo file ) moved to $dst.bak"
    fi
    ln -s "$src" "$dst"
    echo "link $item -> $src"
  done
}

cmd_unshare() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: dotclaude unshare <name> [items...]"
  require_profile "$name"
  shift
  local items="${*:-$SHARE_DEFAULT}" item dst
  local dir="$PROFILES_DIR/$name"
  for item in $items; do
    dst="$dir/$item"
    if [ -L "$dst" ]; then
      rm "$dst"
      if [ -e "$dst.bak" ]; then
        mv "$dst.bak" "$dst"
        echo "restored $item from $dst.bak"
      else
        echo "unlinked $item"
      fi
    else
      err "skip $item: not a shared symlink"
    fi
  done
}

# ---------- items: what config each profile actually has ----------

# json_keys FILE PATH — object keys, one per line (empty when unreadable)
json_keys() {
  local file="$1" path="$2"
  [ -f "$file" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r "($path // {}) | keys[]?" "$file" 2>/dev/null
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$file" "$path" 0 <<'PY' 2>/dev/null
import json, sys
try: d = json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
for k in sys.argv[2].lstrip('.').split('.'):
    if not isinstance(d, dict) or k not in d: sys.exit(0)
    d = d[k]
if isinstance(d, dict):
    for k in sorted(d):
        if sys.argv[3] == "0" or d[k]: print(k)
PY
  fi
}

# json_true_keys FILE PATH — keys whose value is truthy (e.g. enabledPlugins)
json_true_keys() {
  local file="$1" path="$2"
  [ -f "$file" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r "($path // {}) | to_entries[] | select(.value) | .key" "$file" 2>/dev/null
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$file" "$path" 1 <<'PY' 2>/dev/null
import json, sys
try: d = json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
for k in sys.argv[2].lstrip('.').split('.'):
    if not isinstance(d, dict) or k not in d: sys.exit(0)
    d = d[k]
if isinstance(d, dict):
    for k in sorted(d):
        if sys.argv[3] == "0" or d[k]: print(k)
PY
  fi
}

# item_state PATH ITEM — how a named profile holds this item (the default
# profile is the share source, so its own copies need no annotation)
item_state() {
  local dst="$1" target
  if [ -L "$dst" ]; then
    target="$(readlink "$dst")"
    if [ "$target" = "$HOME/.claude/$2" ]; then
      [ -e "$dst" ] && echo shared || echo "shared (BROKEN LINK)"
    else
      echo "-> $target"
    fi
  elif [ -e "$dst" ]; then
    echo own
  fi
}

# md_names DIR MARKER — skill/agent/command names under DIR, one per line.
# Skills are exactly skills/<name>/SKILL.md: a deeper match belongs to a
# checkout vendored inside a skill, not to another skill. Agents and commands
# nest legitimately (commands/<dir>/<name>.md is a namespaced command).
md_names() {
  local dir="$1" marker="$2" f rel depth=""
  [ -d "$dir" ] || return 0
  [ "$marker" = "SKILL.md" ] && depth="-mindepth 2 -maxdepth 2"
  # shellcheck disable=SC2086 -- depth is a deliberate two-flag word split
  find -L "$dir" $depth -type f -name "$marker" 2>/dev/null | sort | while IFS= read -r f; do
    rel="${f#"$dir"/}"
    if [ "$marker" = "SKILL.md" ]; then rel="${rel%/SKILL.md}"; else rel="${rel%.md}"; fi
    printf '%s\n' "$rel"
  done
}

# names_block — wrap a name list from stdin into an indented paragraph
names_block() { tr '\n' ' ' | fold -s -w 68 | sed -e 's/^/      /' -e 's/ *$//' | grep -v '^ *$' || true; }

# blank for the default profile, item_state for the rest
profile_item_state() {
  [ "$1" = "default" ] && return 0
  item_state "$2" "$3"
}

items_line() {
  if [ -n "$3" ]; then printf '  %-17s %-22s %s\n' "$1" "$2" "$3"
  else printf '  %-17s %s\n' "$1" "$2"; fi
}

cmd_items() {
  local names="" show_names=0 arg
  for arg in "$@"; do
    case "$arg" in
      --names) show_names=1 ;;
      -*) die "unknown option: $arg" ;;
      *) names="$arg" ;;
    esac
  done
  if [ -n "$names" ]; then require_profile "$names"; else names="$(all_profiles)"; fi

  local name dir item first=1 n installed enabled non_default=0
  for name in $names; do
    [ "$first" -eq 1 ] || echo
    first=0
    dir="$(profile_dir "$name")"
    [ "$name" = "default" ] || non_default=1
    echo "$(bold "$name")  $dir"

    for item in agents skills commands; do
      if [ "$item" = "skills" ]; then
        n="$(md_names "$dir/skills" SKILL.md | wc -l | tr -d ' ')"
      else
        n="$(md_names "$dir/$item" '*.md' | wc -l | tr -d ' ')"
      fi
      items_line "$item" "$n" "$(profile_item_state "$name" "$dir/$item" "$item")"
      if [ "$show_names" -eq 1 ] && [ "$n" != "0" ]; then
        if [ "$item" = "skills" ]; then md_names "$dir/skills" SKILL.md | names_block
        else md_names "$dir/$item" '*.md' | names_block; fi
      fi
    done

    installed="$(json_keys "$dir/plugins/installed_plugins.json" .plugins)"
    enabled="$(json_true_keys "$dir/settings.json" .enabledPlugins)"
    n="$(printf '%s' "$installed" | grep -c . || true)"
    items_line plugins "$n installed, $(printf '%s' "$enabled" | grep -c . || true) on" \
      "$(profile_item_state "$name" "$dir/plugins" plugins)"
    if [ "$show_names" -eq 1 ] && [ -n "$installed" ]; then
      printf '%s\n' "$installed" | while IFS= read -r p; do
        [ -n "$p" ] || continue
        if printf '%s\n' "$enabled" | grep -qxF "$p"; then printf '%s\n' "$p"; else printf '%s(off)\n' "$p"; fi
      done | names_block
    fi

    n=0
    [ -d "$dir/hooks" ] && n="$(find -L "$dir/hooks" -type f 2>/dev/null | wc -l | tr -d ' ')"
    items_line hooks "$n" "$(profile_item_state "$name" "$dir/hooks" hooks)"

    for item in settings.json keybindings.json CLAUDE.md; do
      items_line "$item" "$( [ -e "$dir/$item" ] && echo present || echo -)" \
        "$(profile_item_state "$name" "$dir/$item" "$item")"
    done
  done

  if [ "$non_default" -eq 1 ]; then
    echo
    echo "\"shared\" = symlinked to ~/.claude (see: dotclaude share). Plugin on/off lives"
    echo "in settings.json, so it is shared exactly when settings.json is."
  fi
}

cmd_doctor() {
  local problems=0 name cfg dir

  echo "$(bold 'dotclaude doctor')"
  echo

  if command -v claude >/dev/null 2>&1; then
    echo "ok    claude found: $(command -v claude)"
  else
    echo "FAIL  claude not found in PATH"
    problems=$((problems + 1))
  fi

  if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    echo "WARN  ANTHROPIC_API_KEY is set — it overrides /login for EVERY profile."
    echo "      unset it (or scope it per-project) or all profiles bill to that key."
    problems=$((problems + 1))
  else
    echo "ok    ANTHROPIC_API_KEY not set"
  fi

  if [ "${DOTCLAUDE_WRAPPER:-}" = "1" ]; then
    echo "ok    shell wrapper active (project bindings work for interactive 'claude')"
  else
    echo "note  shell wrapper not active — .dotclaude bindings are ignored by plain 'claude'."
    echo "      add to ~/.zshrc:  eval \"\$(dotclaude shellenv --alias dc)\""
  fi

  local route
  route="$(global_route || true)"
  if [ -n "$route" ]; then
    if profile_exists "$route"; then
      echo "ok    global route: bare 'claude' -> profile '$route'"
    else
      echo "FAIL  global route points to missing profile '$route' — fix with: dotclaude use default"
      problems=$((problems + 1))
    fi
  fi

  local shared_sessions=0
  for name in $(all_profiles); do
    cfg="$(config_json "$name")"
    dir="$(profile_dir "$name")"
    # shared sessions: flag profiles whose default cleanup prunes the store.
    # Checked before the .claude.json gate — sharing can predate first launch.
    if [ -L "$dir/projects" ] && [ "$(readlink "$dir/projects")" = "$HOME/.claude/projects" ]; then
      shared_sessions=1
      echo "ok    profile '$name': sessions shared with default (~/.claude/projects)"
      local cpd
      if have_json_tool; then
        cpd="$(json_get "$dir/settings.json" .cleanupPeriodDays || true)"
        if [ -z "$cpd" ]; then
          echo "WARN  profile '$name': cleanupPeriodDays unset — its 30-day default cleanup"
          echo "      prunes the SHARED session store. Fix: dotclaude keep $name"
          problems=$((problems + 1))
        fi
      fi
    fi
    if [ ! -f "$cfg" ]; then
      echo "note  profile '$name': no .claude.json yet (never launched?)"
      continue
    fi
    echo "ok    profile '$name': $(account_summary "$cfg")"
    # dangling shared symlinks
    local item dst
    for item in $SHARE_WHITELIST; do
      dst="$dir/$item"
      if [ -L "$dst" ] && [ ! -e "$dst" ]; then
        echo "FAIL  profile '$name': $item is a dangling symlink ($(readlink "$dst"))"
        problems=$((problems + 1))
      fi
    done
  done

  # the default profile participates in any sessions sharing by definition
  if [ "$shared_sessions" -eq 1 ] && have_json_tool; then
    local default_cpd
    default_cpd="$(json_get "$HOME/.claude/settings.json" .cleanupPeriodDays || true)"
    if [ -z "$default_cpd" ]; then
      echo "WARN  profile 'default': cleanupPeriodDays unset — its 30-day default cleanup"
      echo "      prunes the SHARED session store. Fix: dotclaude keep default"
      problems=$((problems + 1))
    fi
  fi

  echo
  if [ "$problems" -eq 0 ]; then echo "No problems found."; else echo "$problems problem(s) found."; fi
}

# Emit normalized usage rows from a profile's .claude.json:
# label<TAB>percent<TAB>resets_at, plus fetched<TAB><epoch_ms>.
usage_rows() {
  local cfg="$1"
  [ -f "$cfg" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r '.cachedUsageUtilization // empty |
      "fetched\t\(.fetchedAtMs // 0)",
      (.utilization.five_hour  | select(. != null) | "5h session\t\(.utilization)\t\(.resets_at // "")"),
      (.utilization.seven_day  | select(. != null) | "weekly (all)\t\(.utilization)\t\(.resets_at // "")"),
      (.utilization.limits[]? | select(.kind == "weekly_scoped") |
        "weekly (\(.scope.model.display_name // "scoped"))\t\(.percent)\t\(.resets_at // "")")' \
      "$cfg" 2>/dev/null
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$cfg" <<'PY' 2>/dev/null
import json, sys
try:
    cache = json.load(open(sys.argv[1])).get("cachedUsageUtilization") or {}
except Exception:
    sys.exit(0)
if not cache:
    sys.exit(0)
u = cache.get("utilization") or {}
print("fetched\t%s" % (cache.get("fetchedAtMs") or 0))
for label, w in (("5h session", u.get("five_hour")), ("weekly (all)", u.get("seven_day"))):
    if w:
        print("%s\t%s\t%s" % (label, w.get("utilization"), w.get("resets_at") or ""))
for lim in u.get("limits") or []:
    if lim.get("kind") == "weekly_scoped":
        model = ((lim.get("scope") or {}).get("model") or {}).get("display_name") or "scoped"
        print("weekly (%s)\t%s\t%s" % (model, lim.get("percent"), lim.get("resets_at") or ""))
PY
  else
    err "usage needs jq or python3"
    return 1
  fi
}

fmt_reset() { # "2026-09-06T00:00:00.204+00:00" -> "2026-09-06 00:00 UTC"
  local t="$1"
  [ -n "$t" ] || { printf '%s' "-"; return; }
  printf '%s' "$t" | sed -e 's/T/ /' -e 's/:[0-9][0-9]\(\.[0-9]*\)\{0,1\}+00:00$/ UTC/' -e 's/:[0-9][0-9]\(\.[0-9]*\)\{0,1\}\([+-][0-9:]*\)$/ \2/'
}

usage_bar() { # percent -> [########------------]
  local pct="$1" filled i out=""
  filled=$((pct / 5)); [ "$filled" -gt 20 ] && filled=20
  i=0
  while [ $i -lt 20 ]; do
    if [ $i -lt "$filled" ]; then out="$out#"; else out="$out-"; fi
    i=$((i + 1))
  done
  printf '[%s]' "$out"
}

cmd_usage() {
  local names="" name rows fetched_ms age_min now_s arg
  for arg in "$@"; do
    case "$arg" in
      -*) die "unknown option: $arg" ;;
      *) names="$arg" ;;
    esac
  done
  if [ -n "$names" ]; then require_profile "$names"; else names="$(all_profiles)"; fi
  now_s="$(date +%s)"
  for name in $names; do
    rows="$(usage_rows "$(config_json "$name")")" || return 1
    if [ -z "$rows" ]; then
      echo "$(bold "$name"): no cached usage data (launch claude once with this profile to populate it)"
      continue
    fi
    fetched_ms="$(printf '%s\n' "$rows" | awk -F'\t' '$1=="fetched"{print $2}')"
    if [ -n "$fetched_ms" ] && [ "$fetched_ms" != "0" ]; then
      age_min=$(( (now_s - fetched_ms / 1000) / 60 ))
      echo "$(bold "$name")  (fetched ${age_min}m ago)"
    else
      echo "$(bold "$name")"
    fi
    printf '%s\n' "$rows" | while IFS="$(printf '\t')" read -r label pct resets; do
      [ "$label" = "fetched" ] && continue
      printf '  %-16s %s %3s%%   resets %s\n' "$label" "$(usage_bar "$pct")" "$pct" "$(fmt_reset "$resets")"
    done
  done
  echo
  echo "Data is Claude Code's own cache, refreshed while claude runs — not live."
}

cmd_du() {
  local name dir
  printf '%-14s %-10s %-10s %s\n' "PROFILE" "TOTAL" "SESSIONS" "DIR"
  for name in $(all_profiles); do
    dir="$(profile_dir "$name")"
    [ -d "$dir" ] || continue
    printf '%-14s %-10s %-10s %s\n' \
      "$name" \
      "$(du -sh "$dir" 2>/dev/null | cut -f1)" \
      "$( if [ -L "$dir/projects" ]; then echo shared; elif [ -d "$dir/projects" ]; then du -sh "$dir/projects" 2>/dev/null | cut -f1; else echo '-'; fi )" \
      "$dir"
  done
}

cmd_clean() {
  local name="${1:-}" days=30 force=0
  [ -n "$name" ] || die "usage: dotclaude clean <name> [--days N] [--force]"
  require_profile "$name"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  case "$days" in ''|*[!0-9]*) die "--days needs a number" ;; esac

  local dir projects
  dir="$(profile_dir "$name")"
  projects="$dir/projects"
  # -L before -d: -d dereferences symlinks and would walk into the shared store
  if [ -L "$projects" ]; then
    err "profile '$name' shares its sessions — projects is a symlink to the shared store."
    err "clean the shared store deliberately instead: dotclaude clean default"
    exit 1
  fi
  [ -d "$projects" ] || { echo "No sessions in profile '$name'."; return 0; }

  local count size
  count="$(find "$projects" -name '*.jsonl' -type f -mtime +"$days" | wc -l | tr -d ' ')"
  if [ "$count" -eq 0 ]; then
    echo "Nothing older than $days days in profile '$name'."
    return 0
  fi
  # sum per-file sizes ourselves: `xargs du -ch | tail -1` under-reports when
  # xargs splits a large file list into batches
  size="$(find "$projects" -name '*.jsonl' -type f -mtime +"$days" -print0 | xargs -0 du -k 2>/dev/null | awk '{s+=$1} END {if (s>1048576) printf "%.1fG", s/1048576; else if (s>1024) printf "%.1fM", s/1024; else printf "%dK", s}')"

  if [ "$force" -eq 1 ]; then
    find "$projects" -name '*.jsonl' -type f -mtime +"$days" -delete
    echo "Deleted $count session transcript(s) ($size) older than $days days from profile '$name'."
  else
    echo "Would delete $count session transcript(s) ($size) older than $days days from profile '$name'."
    echo "Dry run — pass --force to actually delete. Sample:"
    find "$projects" -name '*.jsonl' -type f -mtime +"$days" | head -5 | sed 's/^/  /'
  fi
}

# resolve_link PATH — follow symlinks to the real file. A shared
# settings.json is a symlink into ~/.claude; writing via rename onto the
# link would silently replace it with a private copy and unshare the item.
resolve_link() {
  local p="$1" t
  while [ -L "$p" ]; do
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
  done
  printf '%s\n' "$p"
}

# settings_json_set FILE KEY NUM — merge one numeric key into a JSON settings
# file, preserving everything else. Creates the file if missing. Symlinks
# are followed so the rename lands on the real file (see resolve_link).
settings_json_set() {
  local file key="$2" val="$3" tmp
  file="$(resolve_link "$1")"
  [ -f "$file" ] || printf '{}\n' > "$file"
  tmp="$file.dotclaude-tmp"
  if command -v jq >/dev/null 2>&1; then
    jq --arg k "$key" --argjson v "$val" '.[$k] = $v' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$file" "$key" "$val" > "$tmp" <<'PY' || { rm -f "$tmp"; return 1; }
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
data[sys.argv[2]] = int(sys.argv[3])
print(json.dumps(data, indent=2))
PY
  else
    err "keep needs jq or python3"
    return 1
  fi
  mv "$tmp" "$file"
}

cmd_keep() {
  local name="${1:-}" days=999999
  [ -n "$name" ] || die "usage: dotclaude keep <name> [--days N]"
  require_profile "$name"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days="${2:-}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  case "$days" in ''|*[!0-9]*) die "--days needs a number" ;; esac
  # cleanupPeriodDays=0 has a known Claude Code bug: it disables transcript
  # WRITING entirely, not cleanup. Refuse it.
  [ "$days" -eq 0 ] && die "0 would stop Claude Code writing transcripts at all (known bug) — use a large number instead"
  local file old
  file="$(profile_dir "$name")/settings.json"
  old="$(json_get "$file" '.cleanupPeriodDays' || true)"
  settings_json_set "$file" cleanupPeriodDays "$days" || exit 1
  echo "Set cleanupPeriodDays=${days} for profile '$name' (was: ${old:-unset, default 30})"
  echo "Claude Code will now retain this profile's session transcripts for ${days} days."
  if [ -L "$file" ]; then
    echo "note settings.json is shared ($(readlink "$file")) — this applies to every profile sharing it."
  fi
}

cmd_shellenv() {
  local alias_name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --alias) alias_name="${2:-}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  cat <<EOF
# dotclaude shell integration
export DOTCLAUDE_WRAPPER=1
claude() {
  if [ -z "\${CLAUDE_CONFIG_DIR:-}" ]; then
    local _dc_home="\${DOTCLAUDE_HOME:-\$HOME/.dotclaude}"
    local _dc_dir="\$PWD" _dc_profile="" _dc_src=""
    while :; do
      if [ -f "\$_dc_dir/.dotclaude" ]; then
        _dc_profile=\$(head -n1 "\$_dc_dir/.dotclaude" | tr -d '[:space:]')
        _dc_src="\$_dc_dir/.dotclaude"
        break
      fi
      [ "\$_dc_dir" = "/" ] && break
      _dc_dir=\$(dirname "\$_dc_dir")
    done
    if [ -z "\$_dc_profile" ] && [ -f "\$_dc_home/current" ]; then
      _dc_profile=\$(head -n1 "\$_dc_home/current" | tr -d '[:space:]')
      _dc_src="\$_dc_home/current (global route)"
    fi
    if [ -n "\$_dc_profile" ] && [ "\$_dc_profile" != "default" ]; then
      if [ -d "\$_dc_home/profiles/\$_dc_profile" ]; then
        CLAUDE_CONFIG_DIR="\$_dc_home/profiles/\$_dc_profile" command claude "\$@"
        return
      fi
      echo "dotclaude: profile '\$_dc_profile' not found (from \$_dc_src)" >&2
      return 1
    fi
  fi
  command claude "\$@"
}
EOF
  if [ -n "$alias_name" ]; then
    printf "alias %s='dotclaude'\n" "$alias_name"
  fi
}

# ---------- dispatch ----------

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift
  case "${1:-}" in
    -h|--help)
      case "$cmd" in
        help|version|-v|--version|-h|--help) ;;
        *) cmd_help "$cmd"; return ;;
      esac
      ;;
  esac
  case "$cmd" in
    setup)          cmd_setup "$@" ;;
    run)            cmd_run "$@" ;;
    use)            cmd_use "$@" ;;
    list|ls)        cmd_list "$@" ;;
    current)        cmd_current "$@" ;;
    bind)           cmd_bind "$@" ;;
    unbind)         cmd_unbind "$@" ;;
    share)          cmd_share "$@" ;;
    unshare)        cmd_unshare "$@" ;;
    items)          cmd_items "$@" ;;
    doctor)         cmd_doctor "$@" ;;
    usage)          cmd_usage "$@" ;;
    du)             cmd_du "$@" ;;
    clean)          cmd_clean "$@" ;;
    keep)           cmd_keep "$@" ;;
    shellenv)       cmd_shellenv "$@" ;;
    version|-v|--version) echo "dotclaude $VERSION" ;;
    help|-h|--help) cmd_help "$@" ;;
    *)              die "unknown command: $cmd (see: dotclaude help)" ;;
  esac
}

main "$@"
