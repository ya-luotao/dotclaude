#!/usr/bin/env bash
# Zero-dependency test suite for dotclaude. Each test runs in a hermetic
# sandbox: fresh HOME, fresh DOTCLAUDE_HOME, and a rebuilt PATH containing a
# fake `claude` plus /usr/bin:/bin only — the real claude binary and the real
# ~/.claude are unreachable. Test names reference SPEC.md sections.
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DC="$ROOT/bin/dotclaude"
PASS=0; FAIL=0; FAILED_NAMES=""

# ---------- harness ----------

sandbox() {
  SB="$(mktemp -d "${TMPDIR:-/tmp}/dotclaude-test.XXXXXX")"
  trap 'rm -rf "$SB"' EXIT
  export HOME="$SB/home"
  export DOTCLAUDE_HOME="$HOME/.dotclaude"
  mkdir -p "$HOME/.claude" "$SB/bin"
  printf '#!/bin/sh\necho "fake-claude CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-<unset>} args=[$*]"\n' > "$SB/bin/claude"
  chmod +x "$SB/bin/claude"
  export PATH="$SB/bin:/usr/bin:/bin"
  unset CLAUDE_CONFIG_DIR ANTHROPIC_API_KEY DOTCLAUDE_WRAPPER 2>/dev/null || true
  cd "$SB"
}

mk_profile() { # name [email] [org]
  local dir="$DOTCLAUDE_HOME/profiles/$1"
  mkdir -p "$dir"
  if [ -n "${2:-}" ]; then
    printf '{"oauthAccount":{"emailAddress":"%s","organizationName":"%s"}}\n' "$2" "${3:-Org}" > "$dir/.claude.json"
  fi
}

run_dc() { # capture combined output and status
  set +e
  OUT="$("$DC" "$@" 2>&1)"
  STATUS=$?
}

fail_now() { echo "    ✗ $*"; exit 1; }
assert_status()       { [ "$STATUS" -eq "$1" ] || fail_now "expected exit $1, got $STATUS — output: $OUT"; }
assert_contains()     { case "$OUT" in *"$1"*) ;; *) fail_now "output missing '$1' — output: $OUT" ;; esac; }
assert_not_contains() { case "$OUT" in *"$1"*) fail_now "output should not contain '$1' — output: $OUT" ;; esac; }
assert_file()         { [ -e "$1" ] || fail_now "expected file to exist: $1"; }
assert_no_file()      { [ ! -e "$1" ] || fail_now "expected file to be absent: $1"; }
assert_symlink()      { [ -L "$1" ] || fail_now "expected symlink: $1"; }

t() { # t <name> <fn>
  local name="$1" fn="$2"
  if ( sandbox && "$fn" ); then
    PASS=$((PASS + 1)); echo "  ✓ $name"
  else
    FAIL=$((FAIL + 1)); FAILED_NAMES="$FAILED_NAMES $name"; echo "  ✗ $name"
  fi
}

# ---------- S1/S3: setup guards ----------

s3_setup_refuses_default()  { run_dc setup default; assert_status 1; assert_contains "never needs setup"; }
s3_setup_refuses_invalid()  { run_dc setup 'bad name!'; assert_status 1; assert_contains "invalid profile name"; }
s3_setup_refuses_existing() { mk_profile team; run_dc setup team; assert_status 1; assert_contains "already exists"; }
s3_setup_creates_and_launches() {
  run_dc setup team
  assert_status 0
  assert_file "$DOTCLAUDE_HOME/profiles/team"
  assert_contains "CLAUDE_CONFIG_DIR=$DOTCLAUDE_HOME/profiles/team"
}

# ---------- S4: run ----------

s4_run_named_sets_env() {
  mk_profile team
  run_dc run team --model opus
  assert_status 0
  assert_contains "CLAUDE_CONFIG_DIR=$DOTCLAUDE_HOME/profiles/team"
  assert_contains "args=[--model opus]"
}
s4_run_default_unsets_env() {
  export CLAUDE_CONFIG_DIR=/should/be/removed
  run_dc run default
  unset CLAUDE_CONFIG_DIR
  assert_status 0
  assert_contains "CLAUDE_CONFIG_DIR=<unset>"
}
s4_run_unknown_errors() { run_dc run ghost; assert_status 1; assert_contains "does not exist"; }

# ---------- S5: use (global route) ----------

s5_use_set_show_clear() {
  mk_profile team
  run_dc use team;    assert_status 0; assert_contains "Global route set"
  run_dc use;         assert_status 0; assert_contains "team"
  run_dc use default; assert_status 0; assert_no_file "$DOTCLAUDE_HOME/current"
  run_dc use;         assert_contains "no global route"
}
s5_use_refuses_unknown() { run_dc use ghost; assert_status 1; assert_contains "does not exist"; }
s5_doctor_flags_broken_route() {
  mkdir -p "$DOTCLAUDE_HOME"; echo ghost > "$DOTCLAUDE_HOME/current"
  run_dc doctor
  assert_contains "global route points to missing profile 'ghost'"
  assert_contains "problem(s) found"
}

# ---------- S6: bind / unbind ----------

s6_bind_writes_file() {
  mk_profile team; mkdir -p proj
  run_dc bind team proj
  assert_status 0
  [ "$(cat proj/.dotclaude)" = "team" ] || fail_now "binding file content wrong"
}
s6_bind_refuses_unknown() { mkdir -p proj; run_dc bind ghost proj; assert_status 1; }
s6_unbind_removes_only_local() {
  mk_profile team; mkdir -p proj/sub
  run_dc bind team proj
  run_dc unbind proj/sub          # no local file here; parent must survive
  assert_file proj/.dotclaude
  run_dc unbind proj
  assert_no_file proj/.dotclaude
}

# ---------- S2: resolution order (current + wrapper) ----------

s2_current_default() { run_dc current; assert_contains "default"; }
s2_current_binding_beats_route() {
  mk_profile team; mk_profile other
  run_dc use other
  mkdir -p proj/sub; run_dc bind team proj
  cd proj/sub; run_dc current
  assert_contains "team"
  assert_contains "bound via"
}
s2_current_route_when_no_binding() {
  mk_profile team; run_dc use team
  run_dc current
  assert_contains "team"
  assert_contains "global route"
}

wrapper() { # run bare `claude` through the sourced wrapper, from dir $1
  "$DC" shellenv > "$SB/shellenv.sh" || return 1
  set +e
  OUT="$(cd "$1" && bash -c "source '$SB/shellenv.sh' && claude" 2>&1)"
  STATUS=$?
  set +e
}
s2_wrapper_env_wins() {
  mk_profile team; mkdir -p proj; run_dc bind team proj
  "$DC" shellenv > "$SB/shellenv.sh"
  set +e
  OUT="$(cd proj && CLAUDE_CONFIG_DIR=/explicit bash -c "source '$SB/shellenv.sh' && claude" 2>&1)"
  STATUS=$?
  assert_contains "CLAUDE_CONFIG_DIR=/explicit"
}
s2_wrapper_binding_beats_route() {
  mk_profile team; mk_profile other; run_dc use other
  mkdir -p proj/sub; run_dc bind team proj
  wrapper proj/sub
  assert_contains "profiles/team"
}
s2_wrapper_route_applies() {
  mk_profile team; run_dc use team
  mkdir -p plain; wrapper plain
  assert_contains "profiles/team"
}
s2_wrapper_default_when_nothing() {
  mkdir -p plain; wrapper plain
  assert_contains "CLAUDE_CONFIG_DIR=<unset>"
}
s2_wrapper_missing_profile_errors() {
  mkdir -p proj; echo ghost > proj/.dotclaude
  wrapper proj
  assert_status 1
  assert_contains "profile 'ghost' not found"
  assert_not_contains "fake-claude"     # must not fall through to another account
}
s10_wrapper_works_in_zsh() {
  command -v zsh >/dev/null 2>&1 || return 0   # skip where zsh is absent
  mk_profile team; run_dc use team
  "$DC" shellenv --alias dc > "$SB/shellenv.sh"
  set +e
  OUT="$(zsh -c "source '$SB/shellenv.sh' && claude" 2>&1)"
  STATUS=$?
  assert_contains "profiles/team"
}

# ---------- S7: share / unshare ----------

s7_share_rejects_non_whitelist() {
  mk_profile team
  for item in .credentials.json .claude.json history.jsonl sessions todos settings.local.json; do
    run_dc share team "$item"
    assert_status 1
    assert_contains "not shareable"
  done
}
s7_share_default_set_excludes_projects() {
  mk_profile team
  mkdir -p "$HOME/.claude/agents"
  run_dc share team
  assert_status 0
  [ ! -L "$DOTCLAUDE_HOME/profiles/team/projects" ] || fail_now "bare share must not link projects"
}
s7_share_default_set_includes_plugins() {
  mk_profile team
  mkdir -p "$HOME/.claude/plugins/marketplaces/mkt"
  mkdir -p "$DOTCLAUDE_HOME/profiles/team/plugins"
  echo own > "$DOTCLAUDE_HOME/profiles/team/plugins/known_marketplaces.json"
  run_dc share team
  assert_status 0
  assert_symlink "$DOTCLAUDE_HOME/profiles/team/plugins"
  assert_file "$DOTCLAUDE_HOME/profiles/team/plugins.bak/known_marketplaces.json"
  # the profile's own store is backed up whole, never merged into the shared one
  assert_no_file "$HOME/.claude/plugins/known_marketplaces.json"
  run_dc unshare team plugins
  [ ! -L "$DOTCLAUDE_HOME/profiles/team/plugins" ] || fail_now "symlink not removed"
  assert_file "$DOTCLAUDE_HOME/profiles/team/plugins/known_marketplaces.json"
}
s7_share_default_set_includes_settings_and_hooks() {
  mk_profile team
  mkdir -p "$HOME/.claude/hooks"; echo '#!/bin/sh' > "$HOME/.claude/hooks/pre.sh"
  echo '{"theme":"dark"}' > "$HOME/.claude/settings.json"
  echo '{"theme":"light"}' > "$DOTCLAUDE_HOME/profiles/team/settings.json"
  run_dc share team
  assert_status 0
  assert_symlink "$DOTCLAUDE_HOME/profiles/team/settings.json"
  assert_symlink "$DOTCLAUDE_HOME/profiles/team/hooks"
  assert_file "$DOTCLAUDE_HOME/profiles/team/settings.json.bak"
  [ "$(cat "$DOTCLAUDE_HOME/profiles/team/settings.json")" = '{"theme":"dark"}' ] || fail_now "profile does not see shared settings"
  # keybindings.json is in the default set but absent here: skipped, not fatal
  assert_contains "skip keybindings.json"
  run_dc unshare team
  assert_status 0
  [ "$(cat "$DOTCLAUDE_HOME/profiles/team/settings.json")" = '{"theme":"light"}' ] || fail_now "own settings not restored"
}
s7_share_refuses_stale_bak_for_any_item() {
  mk_profile team
  mkdir -p "$HOME/.claude/agents"
  mkdir -p "$DOTCLAUDE_HOME/profiles/team/agents" "$DOTCLAUDE_HOME/profiles/team/agents.bak"
  echo keep > "$DOTCLAUDE_HOME/profiles/team/agents/a.md"
  run_dc share team agents
  assert_status 1
  assert_contains "already exists"
  # nothing moved: no nesting inside the stale backup
  assert_file "$DOTCLAUDE_HOME/profiles/team/agents/a.md"
  assert_no_file "$DOTCLAUDE_HOME/profiles/team/agents.bak/agents/a.md"
}
s7_share_projects_merges_and_links() {
  mk_profile team
  mkdir -p "$HOME/.claude/projects/proj-a"
  echo shared-old > "$HOME/.claude/projects/proj-a/shared.jsonl"
  mkdir -p "$DOTCLAUDE_HOME/profiles/team/projects/proj-a"
  echo team-only > "$DOTCLAUDE_HOME/profiles/team/projects/proj-a/team.jsonl"
  echo team-ver  > "$DOTCLAUDE_HOME/profiles/team/projects/proj-a/shared.jsonl"
  run_dc share team projects
  assert_status 0
  assert_symlink "$DOTCLAUDE_HOME/profiles/team/projects"
  # profile transcript merged into the shared store
  assert_file "$HOME/.claude/projects/proj-a/team.jsonl"
  # shared store version never overwritten by the merge
  [ "$(cat "$HOME/.claude/projects/proj-a/shared.jsonl")" = "shared-old" ] || fail_now "merge overwrote shared store"
  # original kept as .bak
  assert_file "$DOTCLAUDE_HOME/profiles/team/projects.bak/proj-a/team.jsonl"
  # cleanupPeriodDays unset -> keep suggestion
  assert_contains "dotclaude keep team"
}
s7_share_projects_failed_merge_leaves_profile() {
  mk_profile team
  mkdir -p "$HOME/.claude/projects"
  local p="$DOTCLAUDE_HOME/profiles/team/projects"
  mkdir -p "$p"
  echo ok > "$p/ok.jsonl"
  echo locked > "$p/unreadable.jsonl"; chmod 000 "$p/unreadable.jsonl"
  run_dc share team projects
  chmod 644 "$p/unreadable.jsonl"   # restore so sandbox cleanup works
  assert_status 1
  assert_contains "nothing was moved"
  [ ! -L "$p" ] || fail_now "must not symlink after failed merge"
  assert_file "$p/ok.jsonl"
  assert_no_file "$p.bak"
}
s7_share_projects_refuses_foreign_symlink() {
  mk_profile team
  mkdir -p "$SB/external-store"
  echo ext > "$SB/external-store/ext.jsonl"
  ln -s "$SB/external-store" "$DOTCLAUDE_HOME/profiles/team/projects"
  run_dc share team projects
  assert_status 1
  assert_contains "not touching it"
  # link and its target untouched
  assert_symlink "$DOTCLAUDE_HOME/profiles/team/projects"
  assert_file "$SB/external-store/ext.jsonl"
}
s7_share_projects_refuses_stale_bak() {
  mk_profile team
  mkdir -p "$DOTCLAUDE_HOME/profiles/team/projects" "$DOTCLAUDE_HOME/profiles/team/projects.bak"
  echo x > "$DOTCLAUDE_HOME/profiles/team/projects/x.jsonl"
  run_dc share team projects
  assert_status 1
  assert_contains "projects.bak already exists"
  # nothing moved or linked
  [ ! -L "$DOTCLAUDE_HOME/profiles/team/projects" ] || fail_now "must not link over stale .bak"
  assert_file "$DOTCLAUDE_HOME/profiles/team/projects/x.jsonl"
}
s7_unshare_projects_keeps_shared_transcripts() {
  mk_profile team
  mkdir -p "$HOME/.claude/projects" "$DOTCLAUDE_HOME/profiles/team/projects"
  echo pre > "$DOTCLAUDE_HOME/profiles/team/projects/pre.jsonl"
  run_dc share team projects
  echo during > "$HOME/.claude/projects/during.jsonl"
  run_dc unshare team projects
  assert_status 0
  [ ! -L "$DOTCLAUDE_HOME/profiles/team/projects" ] || fail_now "symlink not removed"
  # pre-share transcript restored to the profile
  assert_file "$DOTCLAUDE_HOME/profiles/team/projects/pre.jsonl"
  # transcript created while shared stays in the shared store
  assert_file "$HOME/.claude/projects/during.jsonl"
  assert_no_file "$DOTCLAUDE_HOME/profiles/team/projects/during.jsonl"
}
s7_share_links_and_backs_up() {
  mk_profile team
  mkdir -p "$HOME/.claude/agents"; echo global > "$HOME/.claude/CLAUDE.md"
  echo local > "$DOTCLAUDE_HOME/profiles/team/CLAUDE.md"
  run_dc share team agents CLAUDE.md
  assert_status 0
  assert_symlink "$DOTCLAUDE_HOME/profiles/team/agents"
  assert_symlink "$DOTCLAUDE_HOME/profiles/team/CLAUDE.md"
  assert_file "$DOTCLAUDE_HOME/profiles/team/CLAUDE.md.bak"
  [ "$(cat "$DOTCLAUDE_HOME/profiles/team/CLAUDE.md.bak")" = "local" ] || fail_now "backup content wrong"
}
s7_share_refuses_default() { run_dc share default agents; assert_status 1; }
s7_unshare_restores_backup() {
  mk_profile team
  echo global > "$HOME/.claude/CLAUDE.md"
  echo local  > "$DOTCLAUDE_HOME/profiles/team/CLAUDE.md"
  run_dc share team CLAUDE.md
  run_dc unshare team CLAUDE.md
  assert_status 0
  [ ! -L "$DOTCLAUDE_HOME/profiles/team/CLAUDE.md" ] || fail_now "symlink not removed"
  [ "$(cat "$DOTCLAUDE_HOME/profiles/team/CLAUDE.md")" = "local" ] || fail_now "backup not restored"
}
s7_unshare_never_deletes_real_files() {
  mk_profile team
  echo precious > "$DOTCLAUDE_HOME/profiles/team/CLAUDE.md"
  run_dc unshare team CLAUDE.md
  assert_file "$DOTCLAUDE_HOME/profiles/team/CLAUDE.md"
  [ "$(cat "$DOTCLAUDE_HOME/profiles/team/CLAUDE.md")" = "precious" ] || fail_now "real file was touched"
}

# ---------- S8: clean ----------

mk_sessions() {
  local p="$DOTCLAUDE_HOME/profiles/team/projects/proj-a"
  mkdir -p "$p"
  echo old > "$p/old.jsonl";  touch -t 202501010000 "$p/old.jsonl"
  echo new > "$p/new.jsonl"
  echo keep > "$p/notes.txt"; touch -t 202501010000 "$p/notes.txt"
}
s8_clean_dry_run_by_default() {
  mk_profile team; mk_sessions
  run_dc clean team --days 30
  assert_status 0
  assert_contains "Would delete 1"
  assert_contains "Dry run"
  assert_file "$DOTCLAUDE_HOME/profiles/team/projects/proj-a/old.jsonl"
}
s8_clean_force_deletes_only_old_jsonl() {
  mk_profile team; mk_sessions
  run_dc clean team --days 30 --force
  assert_status 0
  assert_no_file "$DOTCLAUDE_HOME/profiles/team/projects/proj-a/old.jsonl"
  assert_file "$DOTCLAUDE_HOME/profiles/team/projects/proj-a/new.jsonl"
  assert_file "$DOTCLAUDE_HOME/profiles/team/projects/proj-a/notes.txt"
}
s8_clean_rejects_bad_days()   { mk_profile team; run_dc clean team --days abc; assert_status 1; }
s8_clean_unknown_profile()    { run_dc clean ghost; assert_status 1; }
s8_clean_refuses_shared_profile() {
  mk_profile team
  mkdir -p "$HOME/.claude/projects"
  run_dc share team projects
  run_dc clean team --days 30 --force
  assert_status 1
  assert_contains "shares its sessions"
  assert_contains "clean default"
}
s8_clean_default_prunes_shared_store() {
  mk_profile team
  local p="$HOME/.claude/projects/proj-a"
  mkdir -p "$p"
  echo old > "$p/old.jsonl"; touch -t 202501010000 "$p/old.jsonl"
  echo new > "$p/new.jsonl"
  run_dc clean default --days 30 --force
  assert_status 0
  assert_no_file "$p/old.jsonl"
  assert_file "$p/new.jsonl"
}

# ---------- S9: list / doctor ----------

s9_list_shows_accounts() {
  mk_profile team team@example.com "Acme Corp"
  mk_profile fresh
  run_dc list
  assert_status 0
  assert_contains "team@example.com (Acme Corp)"
  assert_contains "not logged in"
}
s9_doctor_warns_api_key() {
  export ANTHROPIC_API_KEY=sk-test
  run_dc doctor
  unset ANTHROPIC_API_KEY
  assert_contains "ANTHROPIC_API_KEY is set"
  assert_contains "problem(s) found"
}
s9_doctor_flags_dangling_share() {
  mk_profile team
  ln -s "$HOME/.claude/nonexistent-agents" "$DOTCLAUDE_HOME/profiles/team/agents"
  echo '{}' > "$DOTCLAUDE_HOME/profiles/team/.claude.json"
  run_dc doctor
  assert_contains "dangling symlink"
}
s9_doctor_warns_shared_sessions_cleanup() {
  mk_profile team team@example.com
  mkdir -p "$HOME/.claude/projects"
  run_dc share team projects
  run_dc doctor
  assert_contains "sessions shared with default"
  # neither team nor default has cleanupPeriodDays set -> both warned
  assert_contains "dotclaude keep team"
  assert_contains "dotclaude keep default"
  assert_contains "problem(s) found"
}
s9_doctor_ok_when_retention_set() {
  mk_profile team team@example.com
  mkdir -p "$HOME/.claude/projects"
  run_dc share team projects
  run_dc keep team --days 365
  run_dc keep default --days 365
  run_dc doctor
  assert_contains "sessions shared with default"
  assert_not_contains "prunes the SHARED"
}
s9_doctor_reports_share_before_first_launch() {
  mk_profile team   # no email -> no .claude.json yet
  mkdir -p "$HOME/.claude/projects"
  run_dc share team projects
  run_dc doctor
  assert_contains "sessions shared with default"
  assert_contains "dotclaude keep team"
  assert_contains "dotclaude keep default"
}
s9_doctor_skips_cleanup_check_without_json_tools() {
  mk_profile team team@example.com
  mkdir -p "$HOME/.claude/projects"
  run_dc share team projects
  # PATH with every /usr/bin tool except python3 and jq
  mkdir -p "$SB/nojson"
  local f
  for f in /usr/bin/*; do ln -s "$f" "$SB/nojson/$(basename "$f")" 2>/dev/null || true; done
  rm -f "$SB/nojson/python3" "$SB/nojson/jq"
  local oldpath="$PATH"
  PATH="$SB/bin:$SB/nojson:/bin"
  run_dc doctor
  PATH="$oldpath"
  assert_status 0
  assert_contains "sessions shared with default"
  assert_not_contains "prunes the SHARED"
}
s9_du_marks_shared_sessions() {
  mk_profile team team@example.com
  mkdir -p "$HOME/.claude/projects"
  run_dc share team projects
  run_dc du
  assert_status 0
  assert_contains "shared"
}

# ---------- S13: usage ----------

mk_usage_cache() { # writes cachedUsageUtilization into profile $1's .claude.json
  cat > "$DOTCLAUDE_HOME/profiles/$1/.claude.json" <<EOF
{"cachedUsageUtilization":{"fetchedAtMs":$(( $(date +%s) * 1000 )),
 "utilization":{
   "five_hour":{"utilization":44,"resets_at":"2026-09-01T12:50:00.204565+00:00"},
   "seven_day":{"utilization":33,"resets_at":"2026-09-06T00:00:00.204583+00:00"},
   "limits":[
     {"kind":"session","percent":44},
     {"kind":"weekly_scoped","percent":60,"resets_at":"2026-09-06T00:00:00+00:00",
      "scope":{"model":{"display_name":"Fable"}}}]}}}
EOF
}
s13_usage_shows_windows() {
  mk_profile team; mk_usage_cache team
  run_dc usage team
  assert_status 0
  assert_contains "5h session"
  assert_contains "44%"
  assert_contains "weekly (all)"
  assert_contains "33%"
  assert_contains "weekly (Fable)"
  assert_contains "60%"
  assert_contains "resets 2026-09-06 00:00 UTC"
  assert_contains "fetched 0m ago"
}
s13_usage_no_cache_notice() {
  mk_profile fresh
  echo '{}' > "$DOTCLAUDE_HOME/profiles/fresh/.claude.json"
  run_dc usage fresh
  assert_status 0
  assert_contains "no cached usage data"
}
s13_usage_unknown_profile_errors() { run_dc usage ghost; assert_status 1; }
s13_usage_all_profiles() {
  mk_profile team; mk_usage_cache team
  mk_profile fresh
  run_dc usage
  assert_status 0
  assert_contains "team"
  assert_contains "fresh"
  assert_contains "not live"
}
s13_usage_rejects_unknown_option() { run_dc usage --bogus; assert_status 1; assert_contains "unknown option"; }
# ---------- S14: keep ----------

s14_keep_sets_retention() {
  mk_profile team
  run_dc keep team
  assert_status 0
  assert_contains "cleanupPeriodDays=999999"
  grep -q '"cleanupPeriodDays": 999999' "$DOTCLAUDE_HOME/profiles/team/settings.json" \
    || grep -q '"cleanupPeriodDays":999999' "$DOTCLAUDE_HOME/profiles/team/settings.json" \
    || fail_now "settings.json missing cleanupPeriodDays"
}
s14_keep_preserves_other_settings() {
  mk_profile team
  printf '{"model":"opus","cleanupPeriodDays":30}\n' > "$DOTCLAUDE_HOME/profiles/team/settings.json"
  run_dc keep team --days 365
  assert_status 0
  assert_contains "was: 30"
  grep -q '"model"' "$DOTCLAUDE_HOME/profiles/team/settings.json" || fail_now "existing setting lost"
  grep -q '365' "$DOTCLAUDE_HOME/profiles/team/settings.json" || fail_now "days not written"
}
s14_keep_writes_through_shared_settings() {
  mk_profile team
  printf '{"model":"opus"}\n' > "$HOME/.claude/settings.json"
  run_dc share team settings.json
  run_dc keep team --days 365
  assert_status 0
  assert_contains "settings.json is shared"
  assert_symlink "$DOTCLAUDE_HOME/profiles/team/settings.json"
  grep -q '365' "$HOME/.claude/settings.json" || fail_now "days not written to the shared file"
  grep -q '"model"' "$HOME/.claude/settings.json" || fail_now "existing shared setting lost"
}
s14_keep_works_on_default() {
  run_dc keep default
  assert_status 0
  assert_file "$HOME/.claude/settings.json"
}
s14_keep_rejects_bad_days()   { mk_profile team; run_dc keep team --days never; assert_status 1; }
s14_keep_refuses_zero_days() {
  mk_profile team
  run_dc keep team --days 0
  assert_status 1
  assert_contains "known bug"
  assert_no_file "$DOTCLAUDE_HOME/profiles/team/settings.json"
}
s14_keep_unknown_profile()    { run_dc keep ghost; assert_status 1; }

# ---------- S12: self-describing help ----------

help_command_names() { # extract command names from `help` output's Commands block
  "$DC" help | awk '/^Commands:$/{f=1;next} f&&/^$/{exit} f{print $1}'
}
s12_help_lists_all_dispatch_commands() {
  run_dc help
  assert_status 0
  for c in setup run use list current bind unbind share unshare items doctor du clean shellenv help version; do
    assert_contains "$c"
  done
}
s12_every_listed_command_has_topic_help() {
  local c
  for c in $(help_command_names); do
    run_dc help "$c"
    assert_status 0
    assert_contains "Usage: dotclaude $c"
  done
}
s12_dashdash_help_never_executes() {
  mk_profile team; mk_sessions
  run_dc clean --help
  assert_status 0
  assert_contains "--force"
  assert_file "$DOTCLAUDE_HOME/profiles/team/projects/proj-a/old.jsonl"
  run_dc setup --help               # would launch claude if executed
  assert_status 0
  assert_contains "Usage: dotclaude setup"
  assert_not_contains "fake-claude"
}
s12_help_unknown_topic_errors() { run_dc help nope; assert_status 1; assert_contains "unknown command"; }

# ---------- S15: items ----------

mk_items_fixture() { # populate the shared store with one of each item
  mkdir -p "$HOME/.claude/agents" "$HOME/.claude/commands" \
           "$HOME/.claude/skills/alpha/vendor/nested" "$HOME/.claude/skills/beta" \
           "$HOME/.claude/plugins"
  echo a > "$HOME/.claude/agents/scout.md"
  echo c > "$HOME/.claude/commands/rams.md"
  echo s > "$HOME/.claude/skills/alpha/SKILL.md"
  echo s > "$HOME/.claude/skills/beta/SKILL.md"
  echo s > "$HOME/.claude/skills/alpha/vendor/nested/SKILL.md"  # vendored: not a skill
  echo g > "$HOME/.claude/CLAUDE.md"
  echo '{"version":2,"plugins":{"one@mkt":[{"version":"1.0.0"}],"two@mkt":[{"version":"1.0.0"}]}}' \
    > "$HOME/.claude/plugins/installed_plugins.json"
  echo '{"enabledPlugins":{"one@mkt":true,"two@mkt":false}}' > "$HOME/.claude/settings.json"
}
s15_items_counts_and_marks_shared() {
  mk_items_fixture
  mk_profile team
  run_dc share team
  run_dc items
  assert_status 0
  assert_contains "agents            1"
  assert_contains "skills            2"        # the vendored SKILL.md is not a skill
  assert_contains "commands          1"
  assert_contains "shared"
  assert_contains "hooks             0"
  assert_contains "settings.json     present"
  # settings.json is in the default set, so plugin enablement follows it
  assert_contains "2 installed, 1 on"    # default
  assert_not_contains "2 installed, 0 on"
}
s15_items_own_settings_keep_own_enablement() {
  mk_items_fixture
  mk_profile team
  run_dc share team plugins
  run_dc items
  assert_status 0
  assert_contains "2 installed, 1 on"    # default
  assert_contains "2 installed, 0 on"    # team, same store, own settings
}
s15_items_names_lists_skills_and_plugins() {
  mk_items_fixture
  mk_profile team
  run_dc share team
  run_dc items team --names
  assert_status 0
  assert_contains "alpha"
  assert_contains "beta"
  assert_contains "two@mkt(off)"         # shared settings: same enablement as default
  assert_not_contains "one@mkt(off)"
  assert_not_contains "vendor/nested"
}
s15_items_flags_broken_share_link() {
  mk_profile team
  mkdir -p "$HOME/.claude/agents"
  run_dc share team agents
  rm -rf "$HOME/.claude/agents"
  run_dc items team
  assert_status 0
  assert_contains "BROKEN LINK"
}
s15_items_own_copies_are_marked() {
  mk_profile team
  mkdir -p "$DOTCLAUDE_HOME/profiles/team/skills/solo"
  echo s > "$DOTCLAUDE_HOME/profiles/team/skills/solo/SKILL.md"
  run_dc items team
  assert_status 0
  assert_contains "skills            1"
  assert_contains "own"
}
s15_items_rejects_unknown_profile()  { run_dc items nope; assert_status 1; }
s15_items_rejects_unknown_option()   { run_dc items --bogus; assert_status 1; assert_contains "unknown option"; }

